+                        {
+                            let quotes = registry.lock().unwrap_or_else(|e| e.into_inner());
+                            assert!(
+                                quotes.keys().all(|id| id.ends_with("-a")),
+                                "B's planning attempt raised no quote at the mint: {:?}",
+                                quotes.keys().collect::<Vec<_>>()
