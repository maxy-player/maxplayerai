+                        let plan_y = RemittancePlan {
+                            payment_hash: y.payment_hash.clone(),
+                            gross_sats: 15,
+                            net_sats: 13,
+                            melt_fee_reserve_sats: 2,
+                            destination: address.to_string(),
+                            bolt11: y.bolt11.clone(),
+                            melt_quote_id: None,
+                        };
+                        let refused = store_b
+                            .plan_remittance(
+                                &plan_y,
+                                b_plan.owner(),
+                                now.saturating_add(lease_secs(REMIT_LEASE)),
+                                now,
