+                                .expect("rows")
+                                .iter()
+                                .map(|row| (row.remittance_id.as_str(), row.state))
+                                .collect::<Vec<_>>(),
+                            vec![(X_ID, RemittanceState::Spending)],
+                            "the STORE wrote no Y row"
+                        );
+                        assert_eq!(
+                            ledger(store_b),
+                            (0, 15, 0),
+                            "the STORE's refusal left every receipt pinned to X; none became payable"
