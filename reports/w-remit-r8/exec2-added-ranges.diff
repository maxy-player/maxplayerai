+            ),
+            Self::LeaseTooShort {
+                lease_until_unix,
+                now_unix,
+                margin_secs,
+            } => write!(
+                formatter,
+                "the row is ours but its lease {} leaves less than the {margin_secs}s spending margin at unix {now_unix}",
+                match lease_until_unix {
+                    Some(until) => format!("(until unix {until})"),
