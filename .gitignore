/target

# `nix build` output symlinks. The npm packaging script reads result/bin/maxplayer by default, so
# these turn up in the repo root during normal use.
/result
/result-*

# Native binaries are staged into the npm platform packages at pack time: ~38MB of build output
# each, belonging to a release rather than the source tree.
/npm/cli-*/bin/

# Release archives assembled by scripts/package-release-asset.sh.
/dist/

# Scratch / run artifacts (SPIKE_LESSONS refuse-#10: the /target-only gap
# admitted .scratch/ into the spike tree)
.scratch/
*.jsonl
# Evidence bundles are the exception: the raw MCP request/response captures ARE the evidence,
# and a summary PASS line is not a substitute for the observation it summarises. Without this
# exception the *.jsonl rule above silently dropped every transcript the demo recorded
# (advisor F4). Sanitised by construction — no credential value passes through these surfaces.
!evidence/**/*.jsonl

# Environment / secrets
.env
.env.*
# also files NAMED <something>.env — e.g. docker/seller.env, docker/claude-token.env,
# which hold live tokens. The `.env` / `.env.*` patterns above do NOT match these.
*.env

# Editor / OS
.DS_Store
*.swp
